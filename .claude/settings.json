{
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(npm run dev*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed.mjs\""
          }
        ]
      }
    ]
  }
}
